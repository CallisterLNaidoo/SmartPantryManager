<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="30dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pantry Preferences"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="15dp" />

    <Switch
        android:id="@+id/switchExpiryReminders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show expiry reminders"
        android:textSize="16sp"
        android:padding="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="When enabled, the app can alert you about ingredients that are close to their expiry date."
        android:textSize="14sp"
        android:paddingTop="10dp" />

</LinearLayout>